# schwifly env contract — copy to .env (gitignored) and fill in. Nothing here is committed.
# Node 22 loads it natively:  node --env-file=.env ...  (npm scripts inherit your shell env too).

# --- Login (auth-login-at-scale) ------------------------------------------------------------
# The single shared account the `setup` project logs in with. A captured session is reused
# across runs (refreshed when stale) and written to .schwifly/auth/<app>.json — which is a
# CREDENTIAL: it is gitignored and never logged.
#
# Witness target is the free, key-free https://the-internet.herokuapp.com/login:
APP_EMAIL=tomsmith
APP_PASSWORD=SuperSecretPassword!

# --- LLM key (tier-2 AI backup; OPTIONAL) ---------------------------------------------------
# Only needed for the LLM heal tier. Without it the no-LLM heuristic backup still runs and
# `pnpm run verify` stays green key-free. Gemini-first; swap providers with SCHWIFLY_MODEL.
# GEMINI_API_KEY=
# SCHWIFLY_MODEL=google/gemini-2.5-flash
