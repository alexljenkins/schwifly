# Copy to .env. Keep .env and .schwifly/auth/ out of version control.
# Discovery and model repair use OpenRouter. Deterministic replay needs no key.
OPENROUTER_API_KEY=
SCHWIFLY_MODEL=google/gemini-3.5-flash-lite

# Optional authenticated task-app example. Start the server, then run node login.mjs.
# SCHWIFLY_DEMO_AUTH=1
# APP_PASSWORD=

# Legacy the-internet login setup.
# APP_EMAIL=tomsmith
# APP_PASSWORD=SuperSecretPassword!
